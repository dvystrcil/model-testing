index 0000000..1a2b3c4
--- /dev/null
+++ b/notify/webhook.py
@@ -0,0 +1,20 @@
+import time
+import urllib.request
+
+
+def post_with_retry(url, body, max_retries=3):
+    """POST body to url, retrying on failure with linear backoff."""
+    # BUG: range(max_retries - 1) makes only 2 attempts when max_retries=3
+    for attempt in range(max_retries - 1):
+        try:
+            req = urllib.request.Request(url, data=body, method="POST")
+            resp = urllib.request.urlopen(req, timeout=10)
+            if resp.status == 200:
+                return True
+        except Exception:
+            pass
+        time.sleep(attempt + 1)
+    return False
+
+
+def notify(url, body):
+    return post_with_retry(url, body)
